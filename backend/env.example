# ──────────────────────────────────────────
# Supabase (required)
# ──────────────────────────────────────────
# Local development needs no values: memory DB + mock LLM are automatic.
ENVIRONMENT=development
REQUIRE_AUTH=false
# DATABASE_BACKEND=memory
# DATABASE_BACKEND=postgres
# DATABASE_URL=postgresql://roundtable:change_me@127.0.0.1:5432/roundtable
# LLM_BACKEND=mock

# Required only when DATABASE_BACKEND=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ──────────────────────────────────────────
# Google OAuth 2.0 — own credentials
# Get these from https://console.cloud.google.com/apis/credentials
# ──────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The redirect URI you registered in Google Cloud Console.
# Must match EXACTLY (scheme, host, path, port).
# Example values:
#   http://localhost:8000/api/auth/google/callback   (local dev)
#   https://roundtable.works/api/auth/google/callback  (production)
GOOGLE_REDIRECT_URI=

# Where the backend sends the browser after a successful login.
# This should be the URL of your React frontend.
# Example: https://roundtable.works
FRONTEND_URL=

# Email verification for email/password accounts. Create an API key and verify
# the sending domain at https://resend.com. In development/test mode, missing
# credentials log the verification URL instead of sending mail.
RESEND_API_KEY=
AUTH_EMAIL_FROM=Roundtable <accounts@roundtable.works>
# EMAIL_VERIFICATION_TTL_MINUTES=60
# PASSWORD_RESET_TTL_MINUTES=30
# AUTH_SIGNUP_RATE_PER_HOUR=5
# AUTH_LOGIN_RATE_PER_15_MINUTES=10
# AUTH_EMAIL_RATE_PER_HOUR=5
# AUTH_TOKEN_RATE_PER_HOUR=20
# MANUSCRIPT_CREATE_RATE_PER_HOUR=10

# ──────────────────────────────────────────
# LLM API keys — set at least one
# ──────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional: override defaults
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash

# Reader V2 (opt in while A/B evaluation is underway)
# READER_PIPELINE_VERSION=v2
# Comma-separated provider:model routes; readers rotate through the pool.
# READER_MODEL_POOL=gemini:gemini-2.5-flash,anthropic:claude-sonnet-5
# V2 folds the memory delta into the reader call, so this route is reserved for
# future separate repair/compaction jobs rather than called on every section.
# MEMORY_MODEL_ROUTE=gemini:gemini-2.5-flash-lite
# PERSONA_MODEL_ROUTE=openai:gpt-5.6-luna
# EDITOR_MODEL_ROUTE=openai:gpt-5.6-terra
# Long manuscripts are mapped in bounded chunks before the final editor pass.
# EDITOR_MAP_MODEL_ROUTE=openai:gpt-5.6-luna
# EDITOR_DIRECT_MAX_CHARS=220000
# EDITOR_CHUNK_MAX_CHARS=70000
# EDITOR_MAX_CHUNKS=16
# COPYEDIT_MODEL_ROUTE=openai:gpt-5.6-luna
# READER_MAX_CONCURRENCY=2
# READER_START_STAGGER_SECONDS=2
# MAX_WORKFLOW_COST_USD=25

# ──────────────────────────────────────────
# CORS — comma-separated frontend origins
# With allow_credentials=True, do NOT use "*"
# ──────────────────────────────────────────
# CORS_ORIGINS=https://roundtable.works,http://localhost:3000
